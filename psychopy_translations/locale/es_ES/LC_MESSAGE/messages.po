#: psychopy/psychopy/data/experiment.py:466
#, python-brace-format
msgid ""
"Attempted to pause experiment '{}', but it is already paused. Status will "
"remain unchanged."
msgstr ""
"Se intentó pausar el experimento '{}', pero ya está en pausa. El estado se "
"mantendrá sin cambios."

#: psychopy/psychopy/data/experiment.py:482
#, python-brace-format
msgid ""
"Attempted to resume experiment '{}', but it is not paused. Status will "
"remain unchanged."
msgstr ""
"Se intentó reanudar el experimento '{}', pero no está en pausa. El estado se"
" mantendrá sin cambios."

#: psychopy/psychopy/data/experiment.py:495
#, python-brace-format
msgid ""
"Attempted to stop experiment '{}', but it is already stopping. Status will "
"remain unchanged."
msgstr ""
"Se intentó detener el experimento '{}', pero ya se está deteniendo. El "
"estado se mantendrá sin cambios."

#: psychopy/psychopy/data/utils.py:81
msgid "Variables cannot be missing, None, or ''"
msgstr "No pueden faltar variables, Ninguna o ''"

#: psychopy/psychopy/data/utils.py:87
msgid "Variables must be string-like"
msgstr "Las variables deben ser similares a cadenas"

#: psychopy/psychopy/data/utils.py:95
#, python-format
msgid "name %s (type %s) contains non-ASCII characters (e.g. accents)"
msgstr ""
"el nombre %s (tipo %s) contiene caracteres no ASCII (por ejemplo, acentos)"

#: psychopy/psychopy/data/utils.py:100
#, python-format
msgid "name %s (type %s) could not be converted to a string"
msgstr "el nombre %s (tipo %s) no se pudo convertir en una cadena"

#: psychopy/psychopy/data/utils.py:107
msgid "Variables cannot begin with numeric character"
msgstr "Las variables no pueden comenzar con un carácter numérico"

#: psychopy/psychopy/data/utils.py:113
msgid "Variables cannot contain punctuation or spaces"
msgstr "Las variables no pueden contener puntuación ni espacios"

#: psychopy/psychopy/data/utils.py:374
#, python-format
msgid ""
"Conditions file %s: Missing parameter name(s); empty cell(s) in the first "
"row?"
msgstr ""
"Archivo de condiciones %s: faltan nombres de parámetros; celdas vacías en la"
" primera¿fila?"

#: psychopy/psychopy/data/utils.py:401
#, python-format
msgid "Conditions file not found: %s"
msgstr "Archivo de condiciones no encontrado: %s"

#: psychopy/psychopy/data/utils.py:452
msgid ""
"openpyxl or xlrd is required for loading excel files, but neither was found."
msgstr ""
"openpyxl o xlrd es requerido para cargar archivos de excel, pero ninguno ha "
"sido encontrado."

#: psychopy/psychopy/data/utils.py:527
#, python-format
msgid "Could not open %s as conditions"
msgstr "No se pudo abrir %s como condiciones"

#: psychopy/psychopy/data/utils.py:546
msgid "Your conditions file should be an xlsx, csv, dlm, tsv or pkl file"
msgstr ""
"Su archivo de condiciones debe ser un archivo xlsx, csv, dlm, tsv o pkl"

#: psychopy/psychopy/data/utils.py:559
msgid "importConditions() was given some `indices` but could not parse them"
msgstr ""
"a importConditions() se le dieron algunos `índices` pero no se pudieron "
"analizar"

#: psychopy/psychopy/experiment/_experiment.py:706
msgid ""
"Name of the folder in which to save data and log files (blank defaults to "
"the builder pref)"
msgstr ""
"Nombre de la carpeta en la que se guardan los datos y los archivos de "
"registro (el valor predeterminado en blanco es la preferencia del "
"constructor)"

#: psychopy/psychopy/experiment/_experiment.py:770
msgid ""
"This parameter is not known by this version of PsychoPy. It might be worth "
"upgrading, otherwise press the X button to remove this parameter."
msgstr ""
"Esta versión de PsychoPy no conoce este parámetro. Podría valer la pena "
"actualizarla, de otra manera presione X para remover el parámetro."

#: psychopy/psychopy/experiment/components/_base.py:73
msgid "Name of this Component (alphanumeric or _, no spaces)"
msgstr "Nombre de este componente (alfanumérico o _, sin espacios)"

#: psychopy/psychopy/experiment/components/_base.py:79
msgid "How do you want to define your start point?"
msgstr "¿Cómo desea definir su punto de inicio?"

#: psychopy/psychopy/experiment/components/_base.py:84
