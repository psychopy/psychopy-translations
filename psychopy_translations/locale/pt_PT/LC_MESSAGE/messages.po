"Tentativa de interromper a experiência '{}', mas já está a parar. O status "
"permanecerá inalterado."

#: psychopy/psychopy/data/utils.py:81
msgid "Variables cannot be missing, None, or ''"
msgstr "As variáveis ​​não podem estar em falta, None ou ''"

#: psychopy/psychopy/data/utils.py:87
msgid "Variables must be string-like"
msgstr "As variáveis ​​devem conter letras"

#: psychopy/psychopy/data/utils.py:95
#, python-format
msgid "name %s (type %s) contains non-ASCII characters (e.g. accents)"
msgstr "nome %s (tipo %s) contém caractere não ASCII (exemplo, acentos)"

#: psychopy/psychopy/data/utils.py:100
#, python-format
msgid "name %s (type %s) could not be converted to a string"
msgstr ""
"nome %s (tipo %s) não pode ser convertido para uma string (conjunto de "
"letras)"

#: psychopy/psychopy/data/utils.py:107
msgid "Variables cannot begin with numeric character"
msgstr "As variáveis ​​não podem começar com caracteres numéricos"

#: psychopy/psychopy/data/utils.py:113
msgid "Variables cannot contain punctuation or spaces"
msgstr "As variáveis ​​não podem conter pontuação ou espaços"

#: psychopy/psychopy/data/utils.py:374
#, python-format
msgid ""
"Conditions file %s: Missing parameter name(s); empty cell(s) in the first "
"row?"
msgstr ""
"Ficheiro condições %s: Nomes de parâmetros em falta; célula(s) vazia(s) na "
"primeira linha?"

#: psychopy/psychopy/data/utils.py:401
#, python-format
msgid "Conditions file not found: %s"
msgstr "Ficheiro de condições não encontrado: %s"

#: psychopy/psychopy/data/utils.py:452
msgid ""
"openpyxl or xlrd is required for loading excel files, but neither was found."
msgstr ""
"openpyxl ou xlrd é necessário para carregar ficheiros Excel, mas nenhum "
"deles foi encontrado."

#: psychopy/psychopy/data/utils.py:527
#, python-format
msgid "Could not open %s as conditions"
msgstr "Não foi possível abrir %s como condições"

#: psychopy/psychopy/data/utils.py:546
msgid "Your conditions file should be an xlsx, csv, dlm, tsv or pkl file"
msgstr ""
"O seu ficheiro de condições deve ser um ficheiro xlsx, csv, dlm, tsv ou pkl"

#: psychopy/psychopy/data/utils.py:559
msgid "importConditions() was given some `indices` but could not parse them"
msgstr ""
"importConditions() recebeu alguns `indices` mas não conseguiu analisá-los"

#: psychopy/psychopy/experiment/_experiment.py:706
msgid ""
"Name of the folder in which to save data and log files (blank defaults to "
"the builder pref)"
msgstr ""
"Nome da pasta na qual guardar dados e ficheiros log (branco é a predefinição"
" das preferências do builder)"

#: psychopy/psychopy/experiment/_experiment.py:770
