#: psychopy/psychopy/alerts/alertsCatalogue/alertmsg.py:153
#, python-brace-format
msgid "Your stimulus size exceeds the {dimension} dimension of your window."
msgstr ""
"O tamanho do seu estímulo excede a dimensão {dimension} da sua janela."

#: psychopy/psychopy/alerts/alertsCatalogue/alertmsg.py:173
#, python-brace-format
msgid "Your stimulus size is smaller than 1 pixel ({dimension} dimension)."
msgstr "O tamanho do seu estímulo é menor que 1 pixel (dimensão {dimension})."

#: psychopy/psychopy/alerts/alertsCatalogue/alertmsg.py:133
#, python-brace-format
msgid ""
"Your stimulus position exceeds the {dimension} dimension of your window."
msgstr ""
"A posição do seu estímulo excede a dimensão {dimension} da sua janela."

#: psychopy/psychopy/alerts/alertsCatalogue/alertmsg.py:121
#, python-brace-format
msgid ""
"Your stimulus {type} time of {time} is less than a screen refresh for a "
"{Hz}Hz monitor."
msgstr ""
"O tempo {time} do seu estímulo {type} é menor que do uma atualização de ecrã"
" para um monitor {Hz}Hz."

#: psychopy/psychopy/alerts/alertsCatalogue/alertmsg.py:161
#, python-brace-format
msgid ""
"Your stimulus {type} time of {time} seconds cannot be accurately presented "
"for {time} on a {Hz}Hz monitor."
msgstr ""
"O seu estímulo {type} de {time} segundos não pode ser apresentado com "
"precisão para {time} num monitor de {Hz}Hz."

#: psychopy/psychopy/alerts/alertsCatalogue/alertmsg.py:53
#, python-brace-format
msgid ""
"Experiment was built in a future version of PsychoPy ({version}), we "
"recommend either updating PsychoPy or changing the \"Use Version\" setting "
"in Experiment Settings to this version."
msgstr ""
"A experiência foi criada numa versão futura do PsychoPy ({version}), nós "
"recomendamos uma atualização do PsychoPy  ou uma alteração das definições de"
" \"Use Version\" nas Experiment Settings para esta versão."

#: psychopy/psychopy/alerts/alertsCatalogue/alertmsg.py:137
#, python-brace-format
msgid ""
"Experiment was built in a past version of PsychoPy ({version}), saving it in"
" this version may add parameters which cannot be parsed."
msgstr ""
"A experiência foi construída numa versão anterior do PsychoPy ({version}), "
"guardá-la nesta versão pode adicionar parâmetros que não podem ser "
"analisados."

#: psychopy/psychopy/alerts/alertsCatalogue/alertmsg.py:72
#, python-brace-format
msgid ""
"Your stimulus start {type} exceeds the stop {type}. Consider using a {type} "
"duration."
msgstr ""
"O início do seu estímulo {type} excede o stop {type}. Considere utilizar uma"
" duração {type}."

#: psychopy/psychopy/alerts/alertsCatalogue/alertmsg.py:57
#, python-brace-format
msgid ""
"Your stimulus {type} type {frameType} must be expressed as a whole number."
msgstr ""
"O seu estímulo {type} tipo {frameType} deve ser expresso como um número "
"inteiro."

#: psychopy/psychopy/alerts/alertsCatalogue/alertmsg.py:22
#, python-brace-format
msgid ""
"Component {component} has stop time set as a duration, but doesn't have a "
"start time"
msgstr ""
"O componente {component} tem o tempo de fim definido como duração, mas não "
"tem um horário de início"

#: psychopy/psychopy/alerts/alertsCatalogue/alertmsg.py:68
#, python-brace-format
msgid ""
"Python Syntax Error in '{codeTab}' tab. See '{code}' on line number "
"{lineNumber} of the '{codeTab}' tab."
msgstr ""
"Erro de sintaxe Python no separador '{codeTab}'. Consulte '{code}' na linha "
"número {lineNumber} do separador '{codeTab}'."

#: psychopy/psychopy/alerts/alertsCatalogue/alertmsg.py:110
#, python-brace-format
msgid ""
"JavaScript Syntax Error in '{codeTab}' tab. See '{lineNumber}' in the "
"'{codeTab}' tab."
msgstr ""
"Erro de sintaxe JavaScript no separador '{codeTab}'. Consulte '{lineNumber}'"
" no separador '{codeTab}'."

#: psychopy/psychopy/alerts/alertsCatalogue/alertmsg.py:49
#, python-brace-format
msgid ""
"The component {name} is currently disabled and will not be written to your "
"experiment script."
msgstr ""
"O componente {name} está atualmente desativado e não será gravado no script "
"da sua experiência."

#: psychopy/psychopy/alerts/alertsCatalogue/alertmsg.py:60
msgid "Cannot calculate parameter."
msgstr "Não é possível calcular o parâmetro."

#: psychopy/psychopy/alerts/alertsCatalogue/alertmsg.py:88
#, python-brace-format
msgid ""
"Builder cannot interpret value \"{param.val}\" of {param.label} for "
"{component.type} component \"{component.params[name].val}\" as a dollar sign"
" has been used incorrectly."
msgstr ""
"O Builder não pode interpretar o valor \"{param.val}\" de {param.label} para"
" o componente {component.type} \"{component.params[name].val}\" porque o "
"sinal cifrão (ou dollar) foi usado incorretamente."

#: psychopy/psychopy/alerts/alertsCatalogue/alertmsg.py:64
#, python-brace-format
msgid ""
"Font `{param.val}` not found locally, will check Google Fonts on next run."
msgstr ""
"Fonte `{param.val}` não encontrada localmente, irá verificar o Google Fonts "
"na próxima execução."

#: psychopy/psychopy/alerts/alertsCatalogue/alertmsg.py:84
#, python-brace-format
msgid ""
"Font `{font} {style}` not available in weight `{weight}`, component `{name}`"
" will default to Open Sans Regular."
msgstr ""
"O tipo de letra `{font} {style}` não está disponível no peso `{weight}`, o "
"componente `{name}` será predefinido como Open Sans Regular."

#: psychopy/psychopy/alerts/alertsCatalogue/alertmsg.py:15
#, python-brace-format
msgid "Recording device '{device}' not found, using default device instead."
msgstr ""
"Dispositivo de gravação '{device}' não encontrado, utilizando o dispositivo "
"predefinido em alternativa."

#: psychopy/psychopy/alerts/alertsCatalogue/alertmsg.py:76
#, python-brace-format
msgid ""
"The component or routine '{comp}' is only implemented online, so will do "
"nothing when running locally."
msgstr ""
"O component ou a routine '{comp}' só é implementado online, pelo que não "
"fará nada quando executado localmente."

#: psychopy/psychopy/alerts/alertsCatalogue/alertmsg.py:145
#, python-brace-format
msgid ""
"The component or routine '{comp}' is only implemented locally, so will do "
"nothing when running online."
msgstr ""
"O component ou a routine '{comp}' é apenas implementado localmente, pelo que"
" não fará nada quando for executado online."

#: psychopy/psychopy/alerts/alertsCatalogue/alertmsg.py:95
#, python-brace-format
msgid ""
"Editable textbox component {textbox} and keyboard component {keyboard} in "
"the same routine may compete for keypresses"
msgstr ""
"O componente de caixa de texto editável {textbox} e o componente de teclado "
"{keyboard} na mesma routine podem competir pelas mesmas teclas"

#: psychopy/psychopy/alerts/alertsCatalogue/alertmsg.py:98
msgid ""
"Experiment includes components or routines which use eyetracking, but no eye"
" tracker is configured."
msgstr ""
"A experiência inclui componentes ou routines que utilizam rastreador ocular "
"(eyetracking), mas nenhum rastreador ocular (eye tracker) está configurado."

#: psychopy/psychopy/alerts/alertsCatalogue/alertmsg.py:80
#, python-brace-format
msgid ""
"A {eyetracker} eye tracker has been configured, but no calibration routine "
"is present."
msgstr ""
"Um rastreador ocular (eye tracker) {eyetracker} foi configurado, mas não "
"está presente nenhuma routine de calibração."

#: psychopy/psychopy/alerts/alertsCatalogue/alertmsg.py:18
#, python-brace-format
msgid ""
"As {brand} eyetrackers do not support animations in their calibration "
"routine, animation values have not been used in your calibration routine."
msgstr ""
"Uma vez que os rastreadores oculares (eyetrackers) da {brand} não suportam "
"animações na sua routine de calibração, os valores de animação não foram "
"utilizados na sua routine de calibração."

#: psychopy/psychopy/alerts/alertsCatalogue/alertmsg.py:41
#, python-brace-format
msgid "Eyetrackers by {brand} do not support manual pacing"
msgstr ""
"Os rastreadores oculares (eyetrackers) da {brand} não suportam a estimulação"
" manual"

#: psychopy/psychopy/alerts/alertsCatalogue/alertmsg.py:26
msgid ""
"Window mode is set to be windowed, but eyetracking requires the window to be"
" full screen."
msgstr ""
"O modo de janela está configurado para ser em janela (windowed), mas o "
"rastreio ocular (eyetracking) exige que a janela esteja em ecrã inteiro."

#: psychopy/psychopy/alerts/alertsCatalogue/alertmsg.py:106
msgid ""
"A monitor config is required for accurate eyetracking measurements, but none"
" was found."
msgstr ""
"É necessária uma configuração do monitor para medições precisas de rastreio "
"ocular (eyetracking), mas não foi encontrada nenhuma."

#: psychopy/psychopy/alerts/alertsCatalogue/alertmsg.py:149
msgid ""
"Eye tracker experiments should use 'ioHub' as the Input -> Keyboard Backend "
"setting"
msgstr ""
"As experiências com rastreador ocular (eye tracker) devem usar 'ioHub' como "
"configuração de entrada -> definição Keyboard Backend"

#: psychopy/psychopy/alerts/alertsCatalogue/alertmsg.py:125
#, python-brace-format
msgid "Audio transcription service \"{transcriber}\" is not supported online."
msgstr ""
"O serviço de transcrição de áudio \"{transcriber}\" não é compatível online."

#: psychopy/psychopy/alerts/alertsCatalogue/alertmsg.py:129
#, python-brace-format
msgid "Audio transcription service \"{transcriber}\" is not supported offline."
msgstr ""
"O serviço de transcrição de áudio \"{transcriber}\" não é compatível "
"offline."

#: psychopy/psychopy/alerts/alertsCatalogue/alertmsg.py:157
#, python-brace-format
msgid ""
"Chosen transcriber '{engine}' requires an API key, please supply one in "
"Preferences."
msgstr ""
"O transcritor escolhido '{engine}' requer uma chave API, por favor forneça "
"um em Preferências."

#: psychopy/psychopy/alerts/alertsCatalogue/alertmsg.py:102
#, python-brace-format
msgid ""
"Device parameter of microphone component \"{name}\" will not be used online."
msgstr ""
"O parâmetro do dispositivo do componente do microphone \"{name}\" não será "
"utilizado online."

#: psychopy/psychopy/alerts/alertsCatalogue/alertmsg.py:165
#, python-brace-format
msgid ""
"The file you are attempting to run does not seem to exist, the full path "
"supplied to Runner was {path}"
msgstr ""
"O ficheiro que está a tentar executar parece não existir, o caminho completo"
" fornecido ao Runner foi {path}."

#: psychopy/psychopy/alerts/alertsCatalogue/alertmsg.py:177
#, python-brace-format
msgid ""
"Color space attribute `.{colorSpaceAttrib}` is no longer in use, as colors "
"are no longer tied to one space."
msgstr ""
"O atributo de espaço de cor `. {colorSpaceAttrib}` já não está em "
"utilização, uma vez que as cores já não estão ligadas a um espaço."

#: psychopy/psychopy/alerts/alertsCatalogue/alertmsg.py:169
#, python-brace-format
msgid ""
"RGB attribute `.{rgbAttrib}` is no longer in use, as non-RGB colors now "
"handle their own conversion."
msgstr ""
"O atributo RGB `.{rgbAttrib}` já não está em uso, uma vez que as cores não "
"RGB tratam agora da sua própria conversão."

